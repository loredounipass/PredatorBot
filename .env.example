# ═══════════════════════════════════════════════
# 🌐 ALCHEMY RPC ENDPOINTS (Solana Mainnet)
# ═══════════════════════════════════════════════
ALCHEMY_RPC_HTTP_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
ALCHEMY_RPC_WSS_URL=wss://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# ═══════════════════════════════════════════════
# 🔑 WALLET (Base58 or JSON array of 64 bytes)
# ═══════════════════════════════════════════════
PREDATOR_WALLET_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY_HERE

# ═══════════════════════════════════════════════
# 🔴 REDIS CONFIGURATION
# ═══════════════════════════════════════════════
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════
# 🟢 MONGODB CONFIGURATION
# ═══════════════════════════════════════════════
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=PredatorBot_Ledger

# ═══════════════════════════════════════════════
# ⚙️ BOT OPERATIONAL PARAMETERS
# ═══════════════════════════════════════════════
TRADE_AMOUNT_SOL=1.25
MAX_SLIPPAGE_BPS=300
RATE_LIMIT_MAX_RPS=20
WORKER_CONCURRENCY=2
JOB_MAX_RETRY_ATTEMPTS=3
JOB_RETRY_BACKOFF_MS=500
PRIORITY_FEE_MICROLAMPORTS=50000
